@{
    ViewData["Title"] = "Locations";
    ViewData["AdminPage"] = "Locations";
    Layout = "_LayoutAdmin";
}

<div class="admin-toolbar">
    <h2>Locations</h2>
    <button class="admin-btn admin-btn-primary" type="button" onclick="openLocationModal()">Add location</button>
</div>

<div class="admin-table">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Province</th>
                <th>Address</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="locations-tbody"></tbody>
    </table>
</div>

<div class="admin-modal-backdrop" id="location-modal">
    <div class="admin-modal">
        <div class="admin-modal-header">
            <h3 class="admin-modal-title" id="location-modal-title">Add location</h3>
            <button class="admin-btn admin-btn-secondary" type="button" onclick="closeLocationModal()">Close</button>
        </div>
        <form id="location-form">
            <div class="admin-modal-body">
                <input type="hidden" id="location-id" />
                <div class="admin-form-grid">
                    <div class="admin-form-field">
                        <label for="location-name">Name</label>
                        <input id="location-name" required maxlength="100" />
                    </div>
                    <div class="admin-form-field">
                        <label for="location-province">Province</label>
                        <input id="location-province" maxlength="100" />
                    </div>
                    <div class="admin-form-field full">
                        <label for="location-address">Address</label>
                        <input id="location-address" maxlength="200" />
                    </div>
                    <label style="display:flex; gap:8px; align-items:center; color:#111827;">
                        <input id="location-active" type="checkbox" checked />
                        Active
                    </label>
                </div>
                <div class="admin-status" id="location-status"></div>
            </div>
            <div class="admin-modal-footer">
                <button class="admin-btn admin-btn-secondary" type="button" onclick="closeLocationModal()">Cancel</button>
                <button class="admin-btn admin-btn-primary" type="submit">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    let locations = [];

    function esc(value) {
        return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    async function readError(res) {
        try {
            const data = await res.json();
            return data.message || JSON.stringify(data);
        } catch {
            return await res.text();
        }
    }

    async function loadLocations() {
        const res = await fetch('/api/Location');
        if (!res.ok) return;
        locations = await res.json();
        document.getElementById('locations-tbody').innerHTML = locations.map(l => `
            <tr>
                <td>${l.id}</td>
                <td>${esc(l.name)}</td>
                <td>${esc(l.province)}</td>
                <td>${esc(l.addressLine)}</td>
                <td>${l.isActive ? 'Yes' : 'No'}</td>
                <td>
                    <div class="admin-actions">
                        <button class="admin-btn admin-btn-secondary admin-btn-sm" type="button" onclick="openLocationModal(${l.id})">Edit</button>
                        <button class="admin-btn admin-btn-danger admin-btn-sm" type="button" onclick="deleteLocation(${l.id})">Delete</button>
                    </div>
                </td>
            </tr>
        `).join('');
    }

    function openLocationModal(id) {
        const loc = locations.find(l => l.id === id);
        document.getElementById('location-modal-title').textContent = loc ? 'Edit location' : 'Add location';
        document.getElementById('location-id').value = loc?.id || '';
        document.getElementById('location-name').value = loc?.name || '';
        document.getElementById('location-province').value = loc?.province || '';
        document.getElementById('location-address').value = loc?.addressLine || '';
        document.getElementById('location-active').checked = loc ? loc.isActive : true;
        document.getElementById('location-status').textContent = '';
        document.getElementById('location-modal').classList.add('open');
    }

    function closeLocationModal() {
        document.getElementById('location-modal').classList.remove('open');
    }

    document.getElementById('location-form').addEventListener('submit', async e => {
        e.preventDefault();
        const id = document.getElementById('location-id').value;
        const dto = {
            name: document.getElementById('location-name').value.trim(),
            province: document.getElementById('location-province').value.trim() || null,
            addressLine: document.getElementById('location-address').value.trim() || null,
            isActive: document.getElementById('location-active').checked
        };
        const res = await fetch(id ? `/api/Location/${id}` : '/api/Location', {
            method: id ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dto)
        });
        if (!res.ok) {
            document.getElementById('location-status').textContent = await readError(res);
            return;
        }
        closeLocationModal();
        loadLocations();
    });

    async function deleteLocation(id) {
        if (!confirm('Delete this location? Existing routes will keep their references.')) return;
        const res = await fetch(`/api/Location/${id}`, { method: 'DELETE' });
        if (!res.ok) alert(await readError(res));
        loadLocations();
    }

    loadLocations();
</script>
}
