@{
    ViewData["Title"] = "Operations Dashboard";
    ViewData["AdminPage"] = "Dashboard";
    Layout = "_LayoutAdmin";
}

@section Styles {
<style>
    .dash-header-strip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .dash-title-group h1 {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0;
    }
    .dash-title-group p {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin: 4px 0 0;
    }

    /* KPI Metrics Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }
    .kpi-card {
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
    }
    .kpi-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .kpi-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }
    .kpi-icon-box {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--bg-pill);
        border: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-primary);
    }
    .kpi-icon-box i { width: 18px; height: 18px; }
    .kpi-val {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
        color: var(--text-primary);
    }
    .kpi-sub {
        font-size: 0.8125rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .kpi-sub.positive { color: var(--brand-emerald); font-weight: 600; }

    /* Analytics Chart Grid */
    .charts-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
    }
    .chart-card {
        padding: 28px;
    }
    .chart-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }
    .chart-title {
        font-size: 1.125rem;
        font-weight: 700;
        margin: 0;
    }
    .chart-container {
        position: relative;
        height: 280px;
        width: 100%;
    }

    /* Tables & Activity Grid */
    .data-grid-section {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }
    .data-card {
        padding: 28px;
    }
    
    .luxe-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.875rem;
    }
    .luxe-table th {
        padding: 12px 16px;
        background: var(--bg-pill);
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-subtle);
    }
    .luxe-table td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border-subtle);
        color: var(--text-secondary);
    }
    .luxe-table tr:hover td {
        background: var(--bg-pill);
        color: var(--text-primary);
    }

    .alert-item-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-radius: 12px;
        background: var(--bg-pill);
        border: 1px solid var(--border-subtle);
        margin-bottom: 10px;
        gap: 12px;
    }
    .alert-text {
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    @@media (max-width: 1100px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .charts-grid, .data-grid-section { grid-template-columns: 1fr; }
    }
    @@media (max-width: 600px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }
</style>
}

<div class="dash-header-strip">
    <div class="dash-title-group">
        <h1>Operations Dashboard</h1>
        <p>Live revenue metrics, vehicle utilization, and booking performance</p>
    </div>

    <div>
        <button class="btn-luxe-outline" onclick="loadAllDashboardData()">
            <i data-lucide="refresh-cw"></i>
            <span>Refresh Telemetry</span>
        </button>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="kpi-grid">
    <div class="kpi-card luxe-card">
        <div class="kpi-card-top">
            <span class="kpi-label">Gross Revenue</span>
            <div class="kpi-icon-box"><i data-lucide="dollar-sign"></i></div>
        </div>
        <div class="kpi-val" id="stat-revenue">$0</div>
        <div class="kpi-sub positive"><i data-lucide="trending-up"></i> <span id="stat-revenue-target">Target: $150k</span></div>
    </div>

    <div class="kpi-card luxe-card">
        <div class="kpi-card-top">
            <span class="kpi-label">Total Bookings</span>
            <div class="kpi-icon-box"><i data-lucide="ticket"></i></div>
        </div>
        <div class="kpi-val" id="stat-total-bookings">0</div>
        <div class="kpi-sub" id="stat-bookings-month">0 this month</div>
    </div>

    <div class="kpi-card luxe-card">
        <div class="kpi-card-top">
            <span class="kpi-label">Active Fleet</span>
            <div class="kpi-icon-box"><i data-lucide="bus"></i></div>
        </div>
        <div class="kpi-val" id="stat-active-fleet">0</div>
        <div class="kpi-sub" id="stat-fleet-maintenance">0 in maintenance</div>
    </div>

    <div class="kpi-card luxe-card">
        <div class="kpi-card-top">
            <span class="kpi-label">Bookings Today</span>
            <div class="kpi-icon-box"><i data-lucide="calendar-check"></i></div>
        </div>
        <div class="kpi-val" id="stat-bookings-today">0</div>
        <div class="kpi-sub positive" id="stat-confirmed-percent">0% confirmed</div>
    </div>
</div>

<!-- Charts Row with Chart.js -->
<div class="charts-grid">
    <div class="chart-card luxe-card">
        <div class="chart-header">
            <h2 class="chart-title">Revenue &amp; Booking Trends (2026)</h2>
            <span class="badge-luxe badge-neutral">Weekly Revenue</span>
        </div>
        <div class="chart-container">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

    <div class="chart-card luxe-card">
        <div class="chart-header">
            <h2 class="chart-title">Route Passenger Share</h2>
            <span class="badge-luxe badge-neutral">Top Routes</span>
        </div>
        <div class="chart-container">
            <canvas id="routeShareChart"></canvas>
        </div>
    </div>
</div>

<!-- Route Load Table & Alerts -->
<div class="data-grid-section">
    <div class="data-card luxe-card">
        <div class="chart-header">
            <h2 class="chart-title">Live Route Fleet Load</h2>
            <span class="badge-luxe badge-neutral">Today's Performance</span>
        </div>
        <div style="overflow-x:auto;">
            <table class="luxe-table">
                <thead>
                    <tr>
                        <th>Route</th>
                        <th>Trips</th>
                        <th>Passengers</th>
                        <th>Load %</th>
                        <th>Revenue</th>
                    </tr>
                </thead>
                <tbody id="route-load-body">
                    <tr><td colspan="5" style="text-align:center; padding:30px; color:var(--text-muted);">Loading route metrics...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="data-card luxe-card">
        <div class="chart-header">
            <h2 class="chart-title">System Status &amp; Alerts</h2>
            <span class="badge-luxe badge-success"><i data-lucide="check"></i> Normal</span>
        </div>
        <div id="alerts-list">
            <div style="text-align:center; padding:30px; color:var(--text-muted);">Loading system alerts...</div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let revenueChartInstance = null;
    let routeShareChartInstance = null;

    function initCharts() {
        // Line chart for Revenue
        const ctxRevenue = document.getElementById('revenueChart')?.getContext('2d');
        if (ctxRevenue) {
            revenueChartInstance = new Chart(ctxRevenue, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Gross Revenue ($)',
                        data: [1200, 1900, 1700, 2400, 3100, 4200, 3800],
                        borderColor: '#ffffff',
                        backgroundColor: 'rgba(255, 255, 255, 0.06)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#0b0f19',
                        pointBorderWidth: 2,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#94a3b8' }
                        },
                        y: {
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#94a3b8' }
                        }
                    }
                }
            });
        }

        // Doughnut chart for Route Share
        const ctxShare = document.getElementById('routeShareChart')?.getContext('2d');
        if (ctxShare) {
            routeShareChartInstance = new Chart(ctxShare, {
                type: 'doughnut',
                data: {
                    labels: ['PP - Siem Reap', 'PP - Sihanoukville', 'PP - Battambang', 'Other'],
                    datasets: [{
                        data: [45, 25, 20, 10],
                        backgroundColor: ['#ffffff', '#94a3b8', '#475569', '#1e293b'],
                        borderColor: '#0b0f19',
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#94a3b8', boxWidth: 12, padding: 16 }
                        }
                    },
                    cutout: '70%'
                }
            });
        }
    }

    async function loadSummary() {
        try {
            const res = await fetch('/api/Dashboard/summary');
            if (!res.ok) return;
            const data = await res.json();

            document.getElementById('stat-total-bookings').textContent = data.totalBookings.toLocaleString();
            document.getElementById('stat-bookings-month').textContent = `${data.bookingsThisMonth} this month`;
            document.getElementById('stat-active-fleet').textContent = data.activeFleet;
            document.getElementById('stat-fleet-maintenance').textContent = `${data.fleetInMaintenance} in maintenance`;
            document.getElementById('stat-bookings-today').textContent = data.bookingsToday;
            document.getElementById('stat-confirmed-percent').textContent = `${data.bookingsConfirmedPercent}% confirmed`;
            document.getElementById('stat-revenue').textContent = `$${data.grossRevenue.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
            document.getElementById('stat-revenue-target').textContent = `Target: $${data.revenueTarget.toLocaleString()}`;
        } catch (e) {
            console.error('Failed to load dashboard summary', e);
        }
    }

    async function loadRouteLoad() {
        const tbody = document.getElementById('route-load-body');
        try {
            const res = await fetch('/api/Dashboard/route-load');
            if (!res.ok) return;
            const data = await res.json();

            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted); padding:20px;">No route load data recorded today</td></tr>';
                return;
            }

            tbody.innerHTML = data.map(r => {
                let badgeClass = 'badge-success';
                if (r.loadPercent < 50) badgeClass = 'badge-danger';
                else if (r.loadPercent < 80) badgeClass = 'badge-warning';

                return `<tr>
                    <td style="font-weight:700; color:var(--text-primary);">${esc(r.routeName)}</td>
                    <td>${r.trips}</td>
                    <td>${r.passengers.toLocaleString()}</td>
                    <td><span class="badge-luxe ${badgeClass}">${r.loadPercent}%</span></td>
                    <td style="font-weight:700; color:var(--text-primary);">$${r.revenue.toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 })}</td>
                </tr>`;
            }).join('');
        } catch (e) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted); padding:20px;">Failed to load data</td></tr>';
        }
    }

    async function loadAlerts() {
        const container = document.getElementById('alerts-list');
        try {
            const res = await fetch('/api/Dashboard/alerts');
            if (!res.ok) return;
            const data = await res.json();

            if (!data || data.length === 0) {
                container.innerHTML = '<div class="alert-item-box"><span class="alert-text"><i data-lucide="check-circle-2" style="color:var(--brand-emerald);"></i> All systems operational. No active critical alerts.</span></div>';
                if (window.lucide) window.lucide.createIcons();
                return;
            }

            container.innerHTML = data.map(a => `
                <div class="alert-item-box">
                    <div class="alert-text">${esc(a.message)}</div>
                    ${a.actionUrl ? `<a href="${a.actionUrl}" class="btn-luxe-outline" style="padding:4px 10px;font-size:0.75rem;">${esc(a.actionLabel || 'View')}</a>` : ''}
                </div>
            `).join('');

            if (window.lucide) window.lucide.createIcons();
        } catch (e) {
            container.innerHTML = '<div style="text-align:center; color:var(--text-muted); padding:20px;">Failed to load alerts</div>';
        }
    }

    function esc(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function loadAllDashboardData() {
        loadSummary();
        loadRouteLoad();
        loadAlerts();
    }

    document.addEventListener('DOMContentLoaded', function () {
        initCharts();
        loadAllDashboardData();
    });
</script>
}
