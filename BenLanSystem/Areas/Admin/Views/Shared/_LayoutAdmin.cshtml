@{
    var displayName = User?.Identity?.Name ?? "Admin";
    var profileInitial = displayName.Length > 0 ? char.ToUpperInvariant(displayName[0]).ToString() : "A";
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - BenLan Operations Control</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        :root {
            --admin-sidebar-bg: #0b0f19;
            --admin-sidebar-border: rgba(255, 255, 255, 0.08);
            --admin-active-bg: rgba(255, 255, 255, 0.12);
        }

        body {
            background-color: var(--bg-app);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .admin-shell {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .admin-sidebar {
            width: 280px;
            background: var(--admin-sidebar-bg);
            border-right: 1px solid var(--admin-sidebar-border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            z-index: 100;
        }

        .admin-brand {
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--admin-sidebar-border);
        }
        .admin-logo-mark {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--text-primary);
            color: var(--text-inverse);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .admin-logo-mark i { width: 20px; height: 20px; }
        .admin-brand-info h2 {
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0;
            line-height: 1.2;
        }
        .admin-brand-info span {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .admin-menu {
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
            overflow-y: auto;
        }
        .menu-section-label {
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            padding: 12px 14px 4px;
        }
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-secondary);
            transition: all 0.2s ease;
        }
        .admin-nav-link i { width: 18px; height: 18px; opacity: 0.75; }
        .admin-nav-link:hover {
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.05);
        }
        .admin-nav-link.active {
            color: var(--text-inverse);
            background: var(--text-primary);
            font-weight: 600;
        }
        .admin-nav-link.active i { opacity: 1; }

        .admin-sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid var(--admin-sidebar-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .admin-user-summary {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .admin-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--text-primary);
            color: var(--text-inverse);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.875rem;
        }

        /* Main Workspace */
        .admin-workspace {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--bg-app);
            overflow-x: hidden;
        }

        .admin-top-bar {
            height: 70px;
            background: var(--bg-surface);
            border-bottom: 1px solid var(--border-subtle);
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .admin-search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg-pill);
            border: 1px solid var(--border-subtle);
            padding: 8px 16px;
            border-radius: 9999px;
            width: 320px;
        }
        .admin-search-box i { width: 16px; height: 16px; color: var(--text-muted); }
        .admin-search-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-primary);
            font-size: 0.875rem;
            width: 100%;
        }

        .admin-top-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .btn-view-site {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-secondary);
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid var(--border-subtle);
        }
        .btn-view-site:hover {
            color: var(--text-primary);
            border-color: var(--border-medium);
        }
        .btn-view-site i { width: 14px; height: 14px; }

        .admin-view-body {
            padding: 32px;
            flex: 1;
        }

        @@media (max-width: 900px) {
            .admin-shell { flex-direction: column; }
            .admin-sidebar { width: 100%; }
            .admin-search-box { display: none; }
        }
    </style>
</head>
<body>
    <div class="admin-shell">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <div class="admin-logo-mark"><i data-lucide="bus-front"></i></div>
                <div class="admin-brand-info">
                    <h2>BenLan</h2>
                    <span>Operations Control</span>
                </div>
            </div>

            <ul class="admin-menu">
                <li>
                    <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i data-lucide="layout-dashboard"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="menu-section-label">Operations &amp; Fleet</li>
                <li>
                    <a asp-area="Admin" asp-controller="Trips" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Trips" ? "active" : "")">
                        <i data-lucide="calendar"></i>
                        <span>Trip Schedules</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Vehicles" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Vehicles" ? "active" : "")">
                        <i data-lucide="bus"></i>
                        <span>Vehicle Fleet</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Routes" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Routes" ? "active" : "")">
                        <i data-lucide="git-fork"></i>
                        <span>Intercity Routes</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Locations" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Locations" ? "active" : "")">
                        <i data-lucide="map-pin"></i>
                        <span>Terminals &amp; Stations</span>
                    </a>
                </li>

                <li class="menu-section-label">Finance &amp; Customers</li>
                <li>
                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Bookings" ? "active" : "")">
                        <i data-lucide="ticket"></i>
                        <span>Passenger Bookings</span>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Payments" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Payments" ? "active" : "")">
                        <i data-lucide="credit-card"></i>
                        <span>Transactions &amp; KHQR</span>
                    </a>
                </li>

                <li class="menu-section-label">System Control</li>
                <li>
                    <a asp-area="Admin" asp-controller="Staff" asp-action="Index" class="admin-nav-link @(ViewData["AdminPage"]?.ToString() == "Staff" ? "active" : "")">
                        <i data-lucide="shield-check"></i>
                        <span>Staff Directory</span>
                    </a>
                </li>
            </ul>

            <div class="admin-sidebar-footer">
                <div class="admin-user-summary">
                    <div class="admin-avatar">@profileInitial</div>
                    <div>
                        <div style="font-size:0.8125rem;font-weight:700;">@displayName.Split('@')[0]</div>
                        <div style="font-size:0.6875rem;color:var(--text-muted);">Operator</div>
                    </div>
                </div>

                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout" title="Log Out">
                        <i data-lucide="log-out"></i>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="admin-workspace">
            <header class="admin-top-bar">
                <div class="admin-search-box">
                    <i data-lucide="search"></i>
                    <input type="text" placeholder="Quick find trips, bookings, vehicles..." />
                </div>

                <div class="admin-top-actions">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-view-site" target="_blank">
                        <i data-lucide="external-link"></i>
                        <span>Public Portal</span>
                    </a>
                    
                    <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" title="Toggle theme">
                        <i data-lucide="sun" class="theme-icon-light"></i>
                        <i data-lucide="moon" class="theme-icon-dark"></i>
                    </button>
                </div>
            </header>

            <div class="admin-view-body">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
