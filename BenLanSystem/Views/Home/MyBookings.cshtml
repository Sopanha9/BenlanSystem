@{
    ViewData["Title"] = "My Boarding Passes";
    ViewData["ActivePage"] = "MyBookings";
}

@section Styles {
    <style>
        .my-bookings-section {
            padding: 44px 0 80px;
        }
        .mb-page-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 28px;
            flex-wrap: wrap;
            gap: 16px;
        }
        .mb-header-title {
            font-size: 1.9rem;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .passes-container {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .boarding-pass-card {
            display: grid;
            grid-template-columns: 1fr 230px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .boarding-pass-card:hover {
            border-color: var(--border-medium);
            box-shadow: var(--shadow-md);
        }

        .pass-main-section {
            padding: 26px 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 18px;
        }
        .pass-top-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }
        .pass-ref-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--brand-accent);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .pass-ref-pill i { width: 14px; height: 14px; }

        .pass-route-title {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-size: 1.4rem;
            font-weight: 800;
            margin: 8px 0 14px;
        }
        .pass-route-title i { width: 19px; height: 19px; color: var(--brand-sand); }

        .pass-details-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            background: var(--bg-app);
            padding: 14px 18px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-subtle);
        }
        .pass-detail-item {
            display: flex;
            flex-direction: column;
            gap: 3px;
            min-width: 0;
        }
        .detail-item-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }
        .detail-item-val {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        /* Right stub column */
        .pass-stub-section {
            background: var(--bg-app);
            border-left: 2px dashed var(--border-medium);
            padding: 26px 22px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            text-align: center;
            gap: 16px;
        }
        .stub-qr-code {
            width: 96px;
            height: 96px;
            background: #ffffff;
            border-radius: 8px;
            padding: 6px;
            border: 1px solid var(--border-subtle);
        }
        .stub-qr-code img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .stub-actions {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
        }
        .btn-stub-pay {
            width: 100%;
            padding: 9px 14px;
            font-size: 0.8125rem;
        }
        .btn-stub-cancel {
            width: 100%;
            background: transparent;
            border: 1px solid var(--border-subtle);
            color: var(--text-muted);
            padding: 7px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-stub-cancel:hover {
            color: var(--color-danger);
            border-color: var(--color-danger);
        }

        .mb-empty-state {
            text-align: center;
            padding: 72px 20px;
            color: var(--text-secondary);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }
        .mb-empty-state:hover { transform: none; box-shadow: var(--shadow-sm); }

        @@media (max-width: 840px) {
            .boarding-pass-card {
                grid-template-columns: 1fr;
            }
            .pass-stub-section {
                border-left: none;
                border-top: 2px dashed var(--border-medium);
                flex-direction: row;
            }
            .stub-actions { width: auto; }
        }
        @@media (max-width: 560px) {
            .pass-details-row { grid-template-columns: 1fr; gap: 10px; }
            .pass-stub-section { flex-direction: column; }
            .stub-actions { width: 100%; }
        }
    </style>
}

<section class="my-bookings-section">
    <div class="luxe-container">
        <div class="mb-page-header">
            <div>
                <h1 class="mb-header-title">My Boarding Passes</h1>
                <p class="section-subtext">View your digital travel passes, confirmed schedules, and receipts.</p>
            </div>
            <a asp-controller="Home" asp-action="BookTicket" class="btn-luxe-primary">
                <i data-lucide="plus"></i>
                <span>Book New Trip</span>
            </a>
        </div>

        <div class="passes-container" id="mb-list">
            <div class="mb-empty-state luxe-card">
                <div class="spinner-border text-success" role="status"></div>
                <p>Loading your active boarding passes...</p>
            </div>
        </div>

        <div class="pagination-wrapper mt-4 d-flex justify-content-center" id="mb-pagination"></div>
    </div>
</section>

@section Scripts {
<script>
    let currentPage = 1;

    function esc(value) {
        return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    async function loadMyBookings(page = 1) {
        currentPage = page;
        try {
            const res = await fetch(`/api/Booking/my?page=${page}&pageSize=10`);
            if (res.status === 401) { window.location.href = '/Account/Login'; return; }
            if (!res.ok) {
                document.getElementById('mb-list').innerHTML = '<div class="mb-empty-state luxe-card"><p>Unable to load passes at this moment.</p></div>';
                return;
            }
            const data = await res.json();
            renderBookings(data.items || []);
            renderPagination(data);
        } catch (e) {
            document.getElementById('mb-list').innerHTML = '<div class="mb-empty-state luxe-card"><p>Network error loading passes.</p></div>';
        }
    }

    function renderBookings(items) {
        const container = document.getElementById('mb-list');
        if (!items.length) {
            container.innerHTML = `
                <div class="mb-empty-state luxe-card" data-aos="fade-up">
                    <i data-lucide="ticket" style="width:48px;height:48px;opacity:0.4;"></i>
                    <h3 style="font-size:1.25rem;">No Boarding Passes Yet</h3>
                    <p>You have no scheduled upcoming bus departures on this account.</p>
                    <a href="/Home/BookTicket" class="btn-luxe-primary">Search Available Trips</a>
                </div>`;
            if (window.lucide) window.lucide.createIcons();
            return;
        }

        container.innerHTML = items.map((b, idx) => {
            const status = b.bookingStatus || 'Pending';
            let badgeHtml = '<span class="badge-luxe badge-warning"><i data-lucide="clock"></i> Pending Payment</span>';
            if (status === 'Confirmed' || status === 'Paid') {
                badgeHtml = '<span class="badge-luxe badge-success"><i data-lucide="check-circle-2"></i> Confirmed Ticket</span>';
            } else if (status === 'Cancelled') {
                badgeHtml = '<span class="badge-luxe badge-danger"><i data-lucide="x-circle"></i> Cancelled</span>';
            } else if (status === 'Completed') {
                badgeHtml = '<span class="badge-luxe badge-neutral"><i data-lucide="archive"></i> Completed</span>';
            }

            const dep = b.departureTimeUtc ? new Date(b.departureTimeUtc).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) : 'Scheduled';
            const total = Number(b.totalAmount || b.seatsBooked * b.unitPrice || 0).toFixed(2);

            const payBtn = status === 'Pending'
                ? `<a href="/Home/Pay?bookingId=${b.id}" class="btn-luxe-primary btn-stub-pay"><i data-lucide="credit-card"></i> Pay Now</a>`
                : '';
            const cancelBtn = (status === 'Pending' || status === 'Confirmed')
                ? `<button type="button" class="btn-stub-cancel" onclick="cancelBooking(${b.id})">Cancel Ticket</button>`
                : '';

            return `
                <div class="boarding-pass-card" data-aos="fade-up" data-aos-delay="${(idx % 4) * 80}">
                    <!-- Main Ticket Body -->
                    <div class="pass-main-section">
                        <div>
                            <div class="pass-top-meta">
                                <span class="pass-ref-pill"><i data-lucide="barcode"></i> Reference #${b.id}</span>
                                ${badgeHtml}
                            </div>
                            <h2 class="pass-route-title">${esc(b.originName)} <i data-lucide="arrow-right"></i> ${esc(b.destinationName)}</h2>
                        </div>

                        <div class="pass-details-row">
                            <div class="pass-detail-item">
                                <span class="detail-item-label">Departure</span>
                                <span class="detail-item-val">${esc(dep)}</span>
                            </div>
                            <div class="pass-detail-item">
                                <span class="detail-item-label">Seats Reserved</span>
                                <span class="detail-item-val">${b.seatsBooked} Seat(s)</span>
                            </div>
                            <div class="pass-detail-item">
                                <span class="detail-item-label">Total Fare</span>
                                <span class="detail-item-val" style="color:var(--text-primary);font-weight:700;">$${total}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Stub / QR Column -->
                    <div class="pass-stub-section">
                        <div class="stub-qr-code">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=BENLAN-${b.id}" alt="Boarding QR" />
                        </div>
                        <div class="stub-actions">
                            ${payBtn}
                            ${cancelBtn}
                        </div>
                    </div>
                </div>
            `;
        }).join('');

        if (window.lucide) window.lucide.createIcons();
    }

    function renderPagination(data) {
        const container = document.getElementById('mb-pagination');
        const pages = Math.ceil(data.totalCount / data.pageSize);
        if (pages <= 1) { container.innerHTML = ''; return; }
        let html = '<div class="btn-group">';
        for (let i = 1; i <= pages; i++) {
            html += `<button class="btn btn-sm ${i === data.page ? 'btn-light' : 'btn-outline-secondary'}" onclick="loadMyBookings(${i})">${i}</button>`;
        }
        html += '</div>';
        container.innerHTML = html;
    }

    async function cancelBooking(id) {
        const confirmed = await window.BenLanToast?.confirm(
            'Cancel Booking?',
            'Are you sure you want to cancel this booking pass? This cannot be undone.',
            'Yes, Cancel Booking'
        );
        if (!confirmed) return;

        try {
            const res = await fetch(`/api/Booking/${id}/cancel`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: 'Cancelled by user' })
            });

            if (res.ok) {
                window.BenLanToast?.success('Booking Cancelled', 'Your ticket has been cancelled.');
                loadMyBookings(currentPage);
            } else {
                window.BenLanToast?.error('Cancellation Failed', 'Unable to cancel this booking.');
            }
        } catch (e) {
            window.BenLanToast?.error('Error', e.message);
        }
    }

    document.addEventListener('DOMContentLoaded', () => loadMyBookings());
</script>
}
