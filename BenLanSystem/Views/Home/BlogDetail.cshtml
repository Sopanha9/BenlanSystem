@model BenLanSystem.Models.DTOs.BlogPostDto
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary ?? Model.Title;
    ViewData["ActivePage"] = "Blog";
}

@section Styles {
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true"/>
}

<section class="blog-detail-section" id="blog-detail-page">
    <div class="blog-container">
        <div class="blog-detail-header">
            <h1 class="blog-detail-title">@Model.Title</h1>
            <p style="color:#6b7280; font-size:14px; margin-top:8px;">By @Model.AuthorName - @Model.CreatedAtUtc.ToString("yyyy-MM-dd")</p>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" style="width:100%; max-height:400px; object-fit:cover; border-radius:8px; margin-top:16px;" />
            }
        </div>

        <div class="blog-content-rows" id="blog-content-rows">
            <div class="blog-row-card">
                <div class="blog-row-text">
                    <p class="blog-row-desc" style="white-space:pre-line;">@Model.Content</p>
                </div>
            </div>
        </div>

        <nav class="blog-detail-nav" id="blog-detail-nav" aria-label="Blog post navigation">
            <a asp-controller="Home" asp-action="Blog" class="blog-nav-btn" id="blog-nav-back">All posts</a>
        </nav>
    </div>
</section>
