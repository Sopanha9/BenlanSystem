@{
    ViewData["Title"] = "Checkout & Payment";
    ViewData["ActivePage"] = "Book";
    var bookingId = (long)(ViewData["BookingId"] ?? 0);
}

@section Styles {
    <style>
        .pay-page-section {
            padding: 44px 0 80px;
        }
        .pay-grid-layout {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 28px;
            align-items: start;
        }

        .pay-methods-card, .pay-order-summary {
            padding: 28px;
        }
        .pay-methods-card:hover, .pay-order-summary:hover {
            transform: none;
            box-shadow: var(--shadow-sm);
        }

        .pay-section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.2rem;
            margin-bottom: 22px;
        }
        .pay-section-title i { width: 20px; height: 20px; color: var(--brand-primary); }
        [data-theme="dark"] .pay-section-title i { color: var(--brand-sand); }

        .payment-options-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 24px;
        }

        .pay-option-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 18px;
            border-radius: var(--radius-md);
            border: 1.5px solid var(--border-subtle);
            background: var(--bg-surface);
            cursor: pointer;
            transition: border-color 0.15s ease, background-color 0.15s ease;
        }
        .pay-option-card:hover {
            border-color: var(--border-medium);
        }
        .pay-option-card.selected {
            border-color: #163D32;
            background: rgba(22, 61, 50, 0.05);
        }
        [data-theme="dark"] .pay-option-card.selected {
            border-color: #D6B47A;
            background: rgba(214, 180, 122, 0.07);
        }

        .pay-option-left {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }
        .pay-radio {
            accent-color: #163D32;
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }
        [data-theme="dark"] .pay-radio { accent-color: #D6B47A; }
        .pay-method-name {
            font-size: 0.9375rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        .pay-method-tag {
            font-size: 0.7rem;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 6px;
            background: rgba(31, 107, 74, 0.1);
            color: var(--color-success);
            border: 1px solid rgba(31, 107, 74, 0.25);
            white-space: nowrap;
        }

        .khqr-preview-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            background: var(--bg-app);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 22px;
            margin-top: 14px;
        }
        .qr-placeholder {
            width: 156px;
            height: 156px;
            background: #ffffff;
            border-radius: 10px;
            padding: 10px;
            border: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
        }
        .qr-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .qr-instruction {
            font-size: 0.8125rem;
            color: var(--text-secondary);
        }

        .pay-order-summary {
            position: sticky;
            top: 92px;
        }
        .pay-summary-rows {
            display: flex;
            flex-direction: column;
            gap: 13px;
            margin-bottom: 22px;
        }
        .pay-summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-size: 0.9rem;
        }
        .pay-summary-row .label { color: var(--text-secondary); }
        .pay-summary-row .val { font-weight: 600; color: var(--text-primary); text-align: right; }
        .pay-divider { height: 1px; background: var(--border-subtle); margin: 4px 0; }
        .pay-total-row { font-size: 1.05rem; }
        .pay-total-val {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--brand-primary);
        }
        [data-theme="dark"] .pay-total-val { color: var(--brand-sand); }

        .btn-submit-pay {
            width: 100%;
            padding: 14px;
            font-size: 0.9375rem;
        }

        .pay-status-message {
            margin-top: 14px;
            text-align: center;
            font-size: 0.875rem;
            font-weight: 600;
        }

        @@media (max-width: 960px) {
            .pay-grid-layout { grid-template-columns: 1fr; }
            .pay-order-summary { position: static; }
        }
    </style>
}

<section class="pay-page-section">
    <div class="luxe-container">
        <div class="pay-grid-layout">
            <!-- Left: Method Selection -->
            <div class="pay-methods-card luxe-card" data-aos="fade-right">
                <h2 class="pay-section-title"><i data-lucide="credit-card"></i> Select Payment Method</h2>

                <div class="payment-options-grid" id="pay-methods">
                    <label class="pay-option-card selected">
                        <div class="pay-option-left">
                            <input type="radio" name="payMethod" value="ABA" class="pay-radio" checked />
                            <div>
                                <div class="pay-method-name">ABA KHQR</div>
                                <span class="qr-instruction">Scan with ABA Mobile or any Bakong bank app</span>
                            </div>
                        </div>
                        <span class="pay-method-tag">Instant</span>
                    </label>

                    <label class="pay-option-card">
                        <div class="pay-option-left">
                            <input type="radio" name="payMethod" value="ACLEDA" class="pay-radio" />
                            <div>
                                <div class="pay-method-name">ACLEDA Mobile / QR</div>
                                <span class="qr-instruction">Direct ACLEDA KHQR digital transfer</span>
                            </div>
                        </div>
                        <span class="pay-method-tag">Instant</span>
                    </label>

                    <label class="pay-option-card">
                        <div class="pay-option-left">
                            <input type="radio" name="payMethod" value="Wing" class="pay-radio" />
                            <div>
                                <div class="pay-method-name">Wing Bank / WingPay</div>
                                <span class="qr-instruction">Wing digital wallet payment</span>
                            </div>
                        </div>
                    </label>

                    <label class="pay-option-card">
                        <div class="pay-option-left">
                            <input type="radio" name="payMethod" value="Card" class="pay-radio" />
                            <div>
                                <div class="pay-method-name">Credit or Debit Card</div>
                                <span class="qr-instruction">Visa, Mastercard, UnionPay</span>
                            </div>
                        </div>
                    </label>

                    <label class="pay-option-card">
                        <div class="pay-option-left">
                            <input type="radio" name="payMethod" value="Cash" class="pay-radio" />
                            <div>
                                <div class="pay-method-name">Pay at Station Counter</div>
                                <span class="qr-instruction">Present booking reference at terminal</span>
                            </div>
                        </div>
                    </label>
                </div>

                <!-- KHQR Preview Area -->
                <div class="khqr-preview-box" id="khqr-box">
                    <div class="qr-placeholder">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=BENLAN-BOOKING-@bookingId" alt="KHQR Code" />
                    </div>
                    <p class="qr-instruction">Scan to complete payment via any Cambodian Mobile Banking App</p>
                </div>
            </div>

            <!-- Right: Order Summary Sidebar -->
            <div class="pay-order-summary luxe-card" data-aos="fade-left">
                <h3 class="pay-section-title"><i data-lucide="receipt"></i> Booking Summary</h3>

                <div class="pay-summary-rows" id="pay-summary">
                    <div class="pay-summary-row">
                        <span class="label">Booking Ref</span>
                        <span class="val">#@bookingId</span>
                    </div>
                    <div class="pay-summary-row">
                        <span class="label">Loading details...</span>
                        <span class="val"></span>
                    </div>
                </div>

                <button type="button" class="btn-luxe-primary btn-submit-pay" id="pay-btn" onclick="submitPayment()">
                    <span>Confirm &amp; Pay Now</span>
                    <i data-lucide="check-circle-2"></i>
                </button>

                <div class="pay-status-message" id="pay-status"></div>

                <div class="trust-guarantee-note" style="margin-top:20px;">
                    <i data-lucide="lock" style="width:16px;height:16px;color:var(--color-success);"></i>
                    <span>256-bit encrypted checkout. Boarding pass generated automatically upon payment.</span>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    const bookingId = @bookingId;
    let booking = null;

    function esc(value) {
        return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    async function loadBooking() {
        if (!bookingId) {
            document.getElementById('pay-summary').innerHTML = '<div class="pay-summary-row"><span class="label">Missing booking ID</span></div>';
            document.getElementById('pay-btn').disabled = true;
            return;
        }

        try {
            const res = await fetch(`/api/Booking/${bookingId}`);
            if (res.status === 401) { window.location.href = '/Account/Login'; return; }
            if (!res.ok) {
                document.getElementById('pay-summary').innerHTML = '<div class="pay-summary-row"><span class="label">Booking reference not found</span></div>';
                document.getElementById('pay-btn').disabled = true;
                return;
            }

            booking = await res.json();
            const total = Number(booking.totalAmount || booking.seatsBooked * booking.unitPrice || 0).toFixed(2);
            
            document.getElementById('pay-summary').innerHTML = `
                <div class="pay-summary-row">
                    <span class="label">Booking Reference</span>
                    <span class="val">#${booking.id}</span>
                </div>
                <div class="pay-summary-row">
                    <span class="label">Route</span>
                    <span class="val">${esc(booking.originName)} &rarr; ${esc(booking.destinationName)}</span>
                </div>
                <div class="pay-summary-row">
                    <span class="label">Seats Reserved</span>
                    <span class="val">${booking.seatsBooked} seat(s)</span>
                </div>
                <div class="pay-summary-row">
                    <span class="label">Price per seat</span>
                    <span class="val">$${Number(booking.unitPrice || 0).toFixed(2)}</span>
                </div>
                <div class="pay-divider"></div>
                <div class="pay-summary-row pay-total-row">
                    <span class="label">Total Payable</span>
                    <span class="pay-total-val">$${total}</span>
                </div>
            `;

            // Check if already paid
            const existingRes = await fetch(`/api/Payment/booking/${booking.id}`);
            if (existingRes.ok) {
                const payments = await existingRes.json();
                const paid = payments.find(p => p.paymentStatus === 'Paid');
                if (paid) {
                    document.getElementById('pay-status').innerHTML = '<span class="badge-luxe badge-success"><i data-lucide="check"></i> Booking Paid &amp; Confirmed</span>';
                    document.getElementById('pay-btn').disabled = true;
                }
            }

            if (window.lucide) window.lucide.createIcons();
        } catch (e) {
            document.getElementById('pay-summary').innerHTML = '<div class="pay-summary-row"><span class="label">Failed to load booking.</span></div>';
        }
    }

    document.querySelectorAll('input[name="payMethod"]').forEach(r => {
        r.addEventListener('change', function() {
            document.querySelectorAll('.pay-option-card').forEach(l => l.classList.remove('selected'));
            this.closest('.pay-option-card').classList.add('selected');
        });
    });

    async function submitPayment() {
        if (!booking) return;
        const method = document.querySelector('input[name="payMethod"]:checked').value;
        const amount = Number(booking.totalAmount || booking.seatsBooked * booking.unitPrice || 0);
        const btn = document.getElementById('pay-btn');
        
        btn.disabled = true;
        btn.innerHTML = '<div class="spinner-border spinner-border-sm text-light" role="status"></div> <span>Processing payment...</span>';

        try {
            const res = await fetch('/api/Payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    bookingId: booking.id,
                    amount: amount,
                    paymentMethod: method,
                    transactionRef: 'TXN-' + Math.random().toString(36).substring(2, 9).toUpperCase()
                })
            });

            if (res.ok) {
                window.BenLanToast?.success(
                    'Payment Confirmed!',
                    method === 'Cash' ? 'Cash payment noted. Please pay at the counter.' : 'Your booking has been successfully paid!'
                );
                setTimeout(() => window.location.href = '/Home/MyBookings', 1500);
            } else {
                let err = 'Payment could not be processed.';
                try {
                    const data = await res.json();
                    err = data.message || JSON.stringify(data);
                } catch { }
                window.BenLanToast?.error('Payment Failed', err);
                btn.disabled = false;
                btn.innerHTML = '<span>Confirm &amp; Pay Now</span> <i data-lucide="check-circle-2"></i>';
                if (window.lucide) window.lucide.createIcons();
            }
        } catch (e) {
            window.BenLanToast?.error('Network Error', e.message);
            btn.disabled = false;
            btn.innerHTML = '<span>Confirm &amp; Pay Now</span> <i data-lucide="check-circle-2"></i>';
            if (window.lucide) window.lucide.createIcons();
        }
    }

    document.addEventListener('DOMContentLoaded', loadBooking);
</script>
}
