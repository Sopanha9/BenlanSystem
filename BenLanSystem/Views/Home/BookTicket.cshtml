@{
    ViewData["Title"] = "Search & Book Tickets";
    ViewData["ActivePage"] = "Book";
    ViewData["Description"] = "Search scheduled departures, compare vehicle amenities, and reserve seats in seconds.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/bookticket.css" asp-append-version="true"/>
}

<!-- Search Hero Bar -->
<section class="bt-search-section">
    <div class="luxe-container">
        <div class="bt-search-wrapper luxe-card" data-aos="fade-down">
            <div class="bt-search-form">
                <!-- Origin -->
                <div class="bt-input-group">
                    <label class="bt-label"><i data-lucide="map-pin"></i> Origin</label>
                    <div class="bt-input-wrap">
                        <input type="text" placeholder="Departing from" id="bt-input-from" autocomplete="off" list="bt-location-list-from" />
                        <datalist id="bt-location-list-from"></datalist>
                    </div>
                </div>

                <!-- Swap -->
                <button type="button" class="btn-swap-stations" id="bt-swap-btn" title="Swap Origin &amp; Destination" onclick="swapBtStations()">
                    <i data-lucide="arrow-left-right"></i>
                </button>

                <!-- Destination -->
                <div class="bt-input-group">
                    <label class="bt-label"><i data-lucide="navigation"></i> Destination</label>
                    <div class="bt-input-wrap">
                        <input type="text" placeholder="Going to" id="bt-input-to" autocomplete="off" list="bt-location-list-to" />
                        <datalist id="bt-location-list-to"></datalist>
                    </div>
                </div>

                <!-- Departure Date with Flatpickr -->
                <div class="bt-input-group">
                    <label class="bt-label"><i data-lucide="calendar"></i> Date</label>
                    <div class="bt-input-wrap">
                        <input type="text" placeholder="Select Date" id="bt-input-date" />
                    </div>
                </div>

                <!-- Search CTA -->
                <button class="btn-luxe-primary bt-search-submit" id="bt-search-btn" type="button">
                    <i data-lucide="search"></i>
                    <span>Search Trips</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Results List Section -->
<section class="bt-results-section">
    <div class="luxe-container">
        <!-- Results Header / Filter Bar -->
        <div class="bt-filter-bar luxe-card" data-aos="fade-up">
            <div class="bt-results-info">
                <span class="bt-results-count" id="bt-results-count">Showing <strong>0</strong> available departures</span>
            </div>

            <div class="bt-sort-group">
                <label class="bt-sort-label"><i data-lucide="arrow-up-down"></i> Sort by:</label>
                <select class="bt-sort-select" id="bt-sort-select">
                    <option value="departure">Earliest Departure</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                    <option value="duration">Fastest Duration</option>
                </select>
            </div>
        </div>

        <!-- Dynamic Trips List Container -->
        <div class="bt-ticket-list" id="bt-ticket-list">
            <div class="bt-loading-state">
                <div class="spinner-border text-light" role="status"></div>
                <p>Loading available scheduled departures...</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/bookticket.js" asp-append-version="true"></script>
}
