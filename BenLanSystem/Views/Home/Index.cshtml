@{
    ViewData["Title"] = "Luxury Intercity Travel";
    ViewData["ActivePage"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/>
}

<!-- ==========================================================================
     HERO SECTION WITH FLATPICKR BOOKING WIDGET
     ========================================================================== -->
<section class="hero-section" id="hero-section">
    <div class="hero-backdrop">
        <div class="hero-overlay"></div>
        <img src="~/designs/hero.png" alt="Angkor Wat - Cambodia Luxury Transit" class="hero-bg-img" />
    </div>

    <div class="luxe-container hero-content">
        <div class="hero-header-text" data-aos="fade-up">
            <span class="hero-pill"><i data-lucide="sparkles"></i> The Standard of Premium Travel</span>
            <h1 class="hero-title">Travel Cambodia in <span class="gradient-text">Absolute Comfort</span></h1>
            <p class="hero-subtitle">Direct, punctual, and safe express buses &amp; VIP sleeper coaches across Phnom Penh, Siem Reap, Sihanoukville, and beyond.</p>
        </div>

        <!-- Glassmorphism Booking Widget -->
        <div class="hero-booking-widget luxe-card" data-aos="fade-up" data-aos-delay="150">
            <div class="widget-tabs">
                <button type="button" class="tab-btn active"><i data-lucide="bus"></i> One-Way Trip</button>
            </div>

            <form class="hero-search-form" id="hero-booking-form" onsubmit="handleHeroSearch(event)">
                <!-- Origin -->
                <div class="search-input-group">
                    <label class="input-label"><i data-lucide="map-pin"></i> From</label>
                    <div class="input-wrapper">
                        <input type="text" id="hero-input-from" placeholder="e.g. Phnom Penh" autocomplete="off" list="location-list-from" required />
                        <datalist id="location-list-from"></datalist>
                    </div>
                </div>

                <!-- Swap Button -->
                <button type="button" class="btn-swap-stations" id="btn-swap-stations" title="Swap Origin &amp; Destination" onclick="swapStations()">
                    <i data-lucide="arrow-left-right"></i>
                </button>

                <!-- Destination -->
                <div class="search-input-group">
                    <label class="input-label"><i data-lucide="navigation"></i> To</label>
                    <div class="input-wrapper">
                        <input type="text" id="hero-input-to" placeholder="e.g. Siem Reap" autocomplete="off" list="location-list-to" required />
                        <datalist id="location-list-to"></datalist>
                    </div>
                </div>

                <!-- Departure Date with Flatpickr -->
                <div class="search-input-group">
                    <label class="input-label"><i data-lucide="calendar"></i> Date</label>
                    <div class="input-wrapper">
                        <input type="text" id="hero-input-date" placeholder="Select Departure Date" required />
                    </div>
                </div>

                <!-- Search Action -->
                <div class="search-action-group">
                    <button type="submit" class="btn-search-trips" id="hero-search-btn">
                        <i data-lucide="search"></i>
                        <span>Find Trips</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- ==========================================================================
     STATS & TRUST COUNTERS
     ========================================================================== -->
<section class="stats-strip">
    <div class="luxe-container">
        <div class="stats-grid">
            <div class="stat-card" data-aos="fade-up" data-aos-delay="50">
                <div class="stat-icon"><i data-lucide="clock-check"></i></div>
                <div class="stat-info">
                    <h3 class="stat-val">99.8%</h3>
                    <p class="stat-desc">On-Time Departures</p>
                </div>
            </div>
            <div class="stat-card" data-aos="fade-up" data-aos-delay="100">
                <div class="stat-icon"><i data-lucide="users"></i></div>
                <div class="stat-info">
                    <h3 class="stat-val">120,000+</h3>
                    <p class="stat-desc">Happy Travelers</p>
                </div>
            </div>
            <div class="stat-card" data-aos="fade-up" data-aos-delay="150">
                <div class="stat-icon"><i data-lucide="shield-check"></i></div>
                <div class="stat-info">
                    <h3 class="stat-val">100%</h3>
                    <p class="stat-desc">Insured Fleet</p>
                </div>
            </div>
            <div class="stat-card" data-aos="fade-up" data-aos-delay="200">
                <div class="stat-icon"><i data-lucide="headphones"></i></div>
                <div class="stat-info">
                    <h3 class="stat-val">24/7</h3>
                    <p class="stat-desc">Support in Khmer &amp; English</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     QUICK CHECK LIVE SCHEDULE SECTION
     ========================================================================== -->
<section class="luxe-section quick-check-section" id="quick-check-section">
    <div class="luxe-container">
        <div class="section-head" data-aos="fade-up">
            <span class="section-tag"><i data-lucide="zap"></i> Live Departures</span>
            <h2 class="section-heading">Featured Available Trips</h2>
            <p class="section-subtext">Book directly from our upcoming schedule with instant seat reservation.</p>
        </div>

        <div class="trips-grid-wrapper">
            <div class="trips-grid" id="tickets-grid">
                <div id="qc-loading" class="trips-loading-state">
                    <div class="spinner-border text-light" role="status"></div>
                    <p>Loading real-time available departures...</p>
                </div>
            </div>

            <div class="see-more-wrap text-center mt-5">
                <button type="button" class="btn-luxe-outline" id="see-more-btn" onclick="toggleQuickCheck()" style="display:none;">
                    <span>View More Trips</span>
                    <i data-lucide="chevron-down"></i>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     FLEET SHOWCASE (SWIPER.JS CAROUSEL)
     ========================================================================== -->
<section class="luxe-section fleet-section">
    <div class="luxe-container">
        <div class="section-head" data-aos="fade-up">
            <span class="section-tag"><i data-lucide="award"></i> Modern Fleet</span>
            <h2 class="section-heading">Crafted for Exceptional Travel</h2>
            <p class="section-subtext">Every vehicle in the BenLan fleet is meticulously inspected, climate-controlled, and equipped for maximum relaxation.</p>
        </div>

        <!-- Swiper Container -->
        <div class="swiper fleet-swiper" data-aos="fade-up" data-aos-delay="100">
            <div class="swiper-wrapper">
                <!-- Slide 1: VIP Sleeper -->
                <div class="swiper-slide">
                    <div class="fleet-card luxe-card">
                        <div class="fleet-badge">VIP Sleeper</div>
                        <div class="fleet-img-wrap">
                            <img src="~/designs/hero-bus.jpg" alt="VIP Sleeper Bus" class="fleet-img" />
                        </div>
                        <div class="fleet-info">
                            <h3 class="fleet-title">Executive 180° Sleeper Coach</h3>
                            <p class="fleet-desc">Full flat-bed suites designed for night journeys between Phnom Penh, Siem Reap, and Poipet.</p>
                            <div class="fleet-amenities">
                                <span><i data-lucide="wifi"></i> Free Wi-Fi</span>
                                <span><i data-lucide="snowflake"></i> Air Conditioning</span>
                                <span><i data-lucide="plug"></i> USB Port</span>
                                <span><i data-lucide="cup-soda"></i> Free Drinks</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Slide 2: Luxury Van -->
                <div class="swiper-slide">
                    <div class="fleet-card luxe-card">
                        <div class="fleet-badge">VIP Van</div>
                        <div class="fleet-img-wrap">
                            <img src="~/designs/hero.png" alt="Luxury Express Van" class="fleet-img" />
                        </div>
                        <div class="fleet-info">
                            <h3 class="fleet-title">11-Seat Luxury Express Van</h3>
                            <p class="fleet-desc">Spacious reclining captain chairs with generous legroom for rapid daytime intercity transfers.</p>
                            <div class="fleet-amenities">
                                <span><i data-lucide="armchair"></i> Captain Recliner</span>
                                <span><i data-lucide="snowflake"></i> Dual AC</span>
                                <span><i data-lucide="shield"></i> GPS Monitored</span>
                                <span><i data-lucide="luggage"></i> Luggage Space</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Slide 3: Classic Coach -->
                <div class="swiper-slide">
                    <div class="fleet-card luxe-card">
                        <div class="fleet-badge">Express Coach</div>
                        <div class="fleet-img-wrap">
                            <img src="~/designs/hero-bus.jpg" alt="Express Intercity Bus" class="fleet-img" />
                        </div>
                        <div class="fleet-info">
                            <h3 class="fleet-title">Intercity Panorama Coach</h3>
                            <p class="fleet-desc">Panoramic scenic windows, ergonomic seating, and verified professional captains.</p>
                            <div class="fleet-amenities">
                                <span><i data-lucide="eye"></i> Scenic Windows</span>
                                <span><i data-lucide="wifi"></i> 4G Hotspot</span>
                                <span><i data-lucide="shield-check"></i> Certified Driver</span>
                                <span><i data-lucide="snowflake"></i> Climate Control</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Swiper Controls -->
            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"><i data-lucide="arrow-left"></i></div>
            <div class="swiper-button-next"><i data-lucide="arrow-right"></i></div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     POPULAR DESTINATIONS GRID
     ========================================================================== -->
<section class="luxe-section destinations-section" id="destinations-section">
    <div class="luxe-container">
        <div class="section-head" data-aos="fade-up">
            <span class="section-tag"><i data-lucide="compass"></i> Top Destinations</span>
            <h2 class="section-heading">Explore the Kingdom</h2>
            <p class="section-subtext">Discover Cambodia's premier heritage, coastal, and cultural hubs with daily guaranteed departures.</p>
        </div>

        <div class="dest-grid">
            <a asp-controller="Home" asp-action="BookTicket" asp-route-to="Siem Reap" class="dest-card-luxe" data-aos="fade-up" data-aos-delay="50">
                <img src="~/designs/siemreap.png" alt="Siem Reap" class="dest-img" loading="lazy" />
                <div class="dest-gradient"></div>
                <div class="dest-meta">
                    <span class="dest-tag">Temple Gateway</span>
                    <h3 class="dest-name">Siem Reap</h3>
                    <span class="dest-btn"><i data-lucide="arrow-up-right"></i> Book Trips</span>
                </div>
            </a>

            <a asp-controller="Home" asp-action="BookTicket" asp-route-from="Phnom Penh" class="dest-card-luxe" data-aos="fade-up" data-aos-delay="100">
                <img src="~/designs/phnompenh.png" alt="Phnom Penh" class="dest-img" loading="lazy" />
                <div class="dest-gradient"></div>
                <div class="dest-meta">
                    <span class="dest-tag">Capital City</span>
                    <h3 class="dest-name">Phnom Penh</h3>
                    <span class="dest-btn"><i data-lucide="arrow-up-right"></i> Book Trips</span>
                </div>
            </a>

            <a asp-controller="Home" asp-action="BookTicket" asp-route-to="Kampot" class="dest-card-luxe" data-aos="fade-up" data-aos-delay="150">
                <img src="~/designs/kompot.png" alt="Kampot" class="dest-img" loading="lazy" />
                <div class="dest-gradient"></div>
                <div class="dest-meta">
                    <span class="dest-tag">Riverside &amp; Pepper</span>
                    <h3 class="dest-name">Kampot</h3>
                    <span class="dest-btn"><i data-lucide="arrow-up-right"></i> Book Trips</span>
                </div>
            </a>

            <a asp-controller="Home" asp-action="BookTicket" asp-route-to="Battambang" class="dest-card-luxe" data-aos="fade-up" data-aos-delay="200">
                <img src="~/designs/btb.png" alt="Battambang" class="dest-img" loading="lazy" />
                <div class="dest-gradient"></div>
                <div class="dest-meta">
                    <span class="dest-tag">Heritage &amp; Arts</span>
                    <h3 class="dest-name">Battambang</h3>
                    <span class="dest-btn"><i data-lucide="arrow-up-right"></i> Book Trips</span>
                </div>
            </a>

            <a asp-controller="Home" asp-action="BookTicket" asp-route-to="Kampong Thom" class="dest-card-luxe" data-aos="fade-up" data-aos-delay="250">
                <img src="~/designs/kpc.png" alt="Kampong Thom" class="dest-img" loading="lazy" />
                <div class="dest-gradient"></div>
                <div class="dest-meta">
                    <span class="dest-tag">Central Hub</span>
                    <h3 class="dest-name">Kampong Thom</h3>
                    <span class="dest-btn"><i data-lucide="arrow-up-right"></i> Book Trips</span>
                </div>
            </a>

            <a asp-controller="Home" asp-action="BookTicket" asp-route-to="Banteay Meanchey" class="dest-card-luxe" data-aos="fade-up" data-aos-delay="300">
                <img src="~/designs/bmc.png" alt="Banteay Meanchey" class="dest-img" loading="lazy" />
                <div class="dest-gradient"></div>
                <div class="dest-meta">
                    <span class="dest-tag">Northwest Gate</span>
                    <h3 class="dest-name">Banteay Meanchey</h3>
                    <span class="dest-btn"><i data-lucide="arrow-up-right"></i> Book Trips</span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ==========================================================================
     WHY CHOOSE US & VALUES
     ========================================================================== -->
<section class="luxe-section features-section">
    <div class="luxe-container">
        <div class="section-head" data-aos="fade-up">
            <span class="section-tag"><i data-lucide="check-circle-2"></i> The BenLan Advantage</span>
            <h2 class="section-heading">Why Discerning Travelers Choose Us</h2>
            <p class="section-subtext">Setting new benchmarks in safety, punctuality, and passenger convenience.</p>
        </div>

        <div class="features-grid">
            <div class="feature-card luxe-card" data-aos="fade-up" data-aos-delay="50">
                <div class="feature-icon"><i data-lucide="shield-check"></i></div>
                <h4 class="feature-title">Full Liability Insurance</h4>
                <p class="feature-desc">Every passenger and vehicle is covered by comprehensive international and domestic transit insurance.</p>
            </div>

            <div class="feature-card luxe-card" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-icon"><i data-lucide="qr-code"></i></div>
                <h4 class="feature-title">Instant KHQR &amp; Card Pay</h4>
                <p class="feature-desc">Direct digital checkout with ABA KHQR, ACLEDA, Wing, and cards. Your digital boarding pass arrives instantly.</p>
            </div>

            <div class="feature-card luxe-card" data-aos="fade-up" data-aos-delay="150">
                <div class="feature-icon"><i data-lucide="armchair"></i></div>
                <h4 class="feature-title">Reduced-Capacity Seating</h4>
                <p class="feature-desc">We removed redundant seats across our fleet to give you generous legroom and true executive reclining comfort.</p>
            </div>

            <div class="feature-card luxe-card" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-icon"><i data-lucide="cup-soda"></i></div>
                <h4 class="feature-title">Complimentary Refreshments</h4>
                <p class="feature-desc">Pure bottled water, cold refreshing towels, and charging outlets are complimentary on every journey.</p>
            </div>

            <div class="feature-card luxe-card" data-aos="fade-up" data-aos-delay="250">
                <div class="feature-icon"><i data-lucide="snowflake"></i></div>
                <h4 class="feature-title">Climate-Controlled Cabins</h4>
                <p class="feature-desc">Precision temperature regulation and air filtration systems keep your ride pleasant throughout the trip.</p>
            </div>

            <div class="feature-card luxe-card" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-icon"><i data-lucide="phone-call"></i></div>
                <h4 class="feature-title">24/7 Dedicated Support</h4>
                <p class="feature-desc">Our dedicated team is reachable at any time via hotline, Telegram, and live station desks.</p>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     FREQUENTLY ASKED QUESTIONS (ACCORDION)
     ========================================================================== -->
<section class="luxe-section faq-section" id="faqs-section">
    <div class="luxe-container">
        <div class="section-head" data-aos="fade-up">
            <span class="section-tag"><i data-lucide="help-circle"></i> Clear Answers</span>
            <h2 class="section-heading">Frequently Asked Questions</h2>
            <p class="section-subtext">Everything you need to know about booking, baggage, check-in, and payments.</p>
        </div>

        <div class="faq-accordion" id="faqs-list">
            <div class="faq-item luxe-card" data-aos="fade-up">
                <button class="faq-trigger" onclick="toggleFaq(this)" aria-expanded="false">
                    <span class="faq-question">How does online booking and seat selection work?</span>
                    <i data-lucide="chevron-down" class="faq-icon"></i>
                </button>
                <div class="faq-body">
                    <div class="faq-content">
                        Search your route, select your preferred departure time, and click <strong>Select Seat</strong> to view the live bus deck layout. Once selected, proceed to checkout with ABA KHQR, Card, or Station Pay to get your instant boarding pass.
                    </div>
                </div>
            </div>

            <div class="faq-item luxe-card" data-aos="fade-up" data-aos-delay="50">
                <button class="faq-trigger" onclick="toggleFaq(this)" aria-expanded="false">
                    <span class="faq-question">How early should I arrive at the departure terminal?</span>
                    <i data-lucide="chevron-down" class="faq-icon"></i>
                </button>
                <div class="faq-body">
                    <div class="faq-content">
                        We recommend arriving at least <strong>15 to 20 minutes prior</strong> to scheduled departure to check in your luggage and board calmly.
                    </div>
                </div>
            </div>

            <div class="faq-item luxe-card" data-aos="fade-up" data-aos-delay="100">
                <button class="faq-trigger" onclick="toggleFaq(this)" aria-expanded="false">
                    <span class="faq-question">What payment methods are supported?</span>
                    <i data-lucide="chevron-down" class="faq-icon"></i>
                </button>
                <div class="faq-body">
                    <div class="faq-content">
                        We support <strong>ABA KHQR</strong> (scan to pay with any Cambodian banking app), ACLEDA, Wing, Visa/Mastercard, and Cash payment at the terminal counter.
                    </div>
                </div>
            </div>

            <div class="faq-item luxe-card" data-aos="fade-up" data-aos-delay="150">
                <button class="faq-trigger" onclick="toggleFaq(this)" aria-expanded="false">
                    <span class="faq-question">What is the luggage allowance per ticket?</span>
                    <i data-lucide="chevron-down" class="faq-icon"></i>
                </button>
                <div class="faq-body">
                    <div class="faq-content">
                        Each passenger is entitled to 1 standard suitcase/backpack (up to 20kg) stored in the luggage compartment plus 1 small carry-on personal bag inside the cabin.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    let quickCheckTrips = [];
    let locations = [];

    function escHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, function(c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
    }

    function formatTime(utcString) {
        if (!utcString) return '';
        return new Date(utcString).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    // Initialize Flatpickr on Hero Search Date
    function initHeroFlatpickr() {
        flatpickr("#hero-input-date", {
            minDate: "today",
            dateFormat: "Y-m-d",
            defaultDate: "today",
            disableMobile: "true"
        });
    }

    // Load locations for autocomplete
    async function loadLocations() {
        try {
            const res = await fetch('/api/Location');
            if (!res.ok) return;
            locations = await res.json();

            const fromList = document.getElementById('location-list-from');
            const toList = document.getElementById('location-list-to');
            if (fromList && toList) {
                const options = locations.map(l => `<option value="${escHtml(l.name)}"></option>`).join('');
                fromList.innerHTML = options;
                toList.innerHTML = options;
            }
        } catch (e) {
            console.error('Error loading locations:', e);
        }
    }

    function swapStations() {
        const fromInput = document.getElementById('hero-input-from');
        const toInput = document.getElementById('hero-input-to');
        if (fromInput && toInput) {
            const temp = fromInput.value;
            fromInput.value = toInput.value;
            toInput.value = temp;
        }
    }

    function handleHeroSearch(e) {
        e.preventDefault();
        const from = document.getElementById('hero-input-from').value.trim();
        const to = document.getElementById('hero-input-to').value.trim();
        const date = document.getElementById('hero-input-date').value.trim();

        const params = new URLSearchParams();
        if (from) params.append('from', from);
        if (to) params.append('to', to);
        if (date) params.append('date', date);

        window.location.href = '/Home/BookTicket?' + params.toString();
    }

    // Quick Check Live Trips
    async function loadQuickCheck() {
        try {
            const res = await fetch('/api/Trip?StatusName=Open&PageSize=9');
            if (!res.ok) {
                document.getElementById('qc-loading').innerHTML = '<p class="text-muted">Unable to load live schedule at this moment.</p>';
                return;
            }
            const data = await res.json();
            quickCheckTrips = data.items || [];
            renderQuickCheckCards(quickCheckTrips);
        } catch {
            document.getElementById('qc-loading').innerHTML = '<p class="text-muted">Unable to load live schedule at this moment.</p>';
        }
    }

    function renderQuickCheckCards(trips) {
        const grid = document.getElementById('tickets-grid');
        const seeMoreBtn = document.getElementById('see-more-btn');

        if (!trips.length) {
            grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:48px;color:var(--text-muted);">No upcoming trips scheduled currently. Check back soon.</div>';
            if (seeMoreBtn) seeMoreBtn.style.display = 'none';
            return;
        }

        grid.innerHTML = trips.map(function(t, i) {
            const depTime = formatTime(t.departureTimeUtc);
            const departureDate = t.departureTimeUtc ? new Date(t.departureTimeUtc).toLocaleDateString([], { month: 'short', day: 'numeric' }) : '';
            const price = '$' + Number(t.basePrice || 0).toFixed(2);
            const isExtra = i >= 3 ? ' ticket-card-extra hidden' : '';
            const seatsLeft = Number(t.availableSeats || 0);
            const vehicleType = t.vehicleBrand ? `${t.vehicleBrand} ${t.vehicleModel || ''}` : 'VIP Transit';

            return `
                <div class="trip-card luxe-card${isExtra}" id="qc-card-${i}" data-aos="fade-up" data-aos-delay="${(i % 3) * 100}">
                    <div class="trip-card-top">
                        <div class="trip-vehicle-badge">
                            <i data-lucide="bus"></i>
                            <span>${escHtml(vehicleType)}</span>
                        </div>
                        <span class="trip-seats-pill ${seatsLeft < 5 ? 'low' : ''}">
                            <i data-lucide="user"></i> ${seatsLeft} seats left
                        </span>
                    </div>

                    <div class="trip-route-timeline">
                        <div class="timeline-station">
                            <span class="station-time">${depTime || '08:00 AM'}</span>
                            <span class="station-name">${escHtml(t.originName)}</span>
                        </div>
                        <div class="timeline-divider">
                            <i data-lucide="arrow-right"></i>
                        </div>
                        <div class="timeline-station right">
                            <span class="station-date">${departureDate}</span>
                            <span class="station-name">${escHtml(t.destinationName)}</span>
                        </div>
                    </div>

                    <div class="trip-card-bottom">
                        <div class="trip-price-wrap">
                            <span class="price-label">Price per seat</span>
                            <span class="price-amount">${price}</span>
                        </div>
                        <a href="/Home/SelectSeat?tripId=${t.id}" class="btn-luxe-primary btn-book-card">
                            <span>Select Seat</span>
                            <i data-lucide="chevron-right"></i>
                        </a>
                    </div>
                </div>`;
        }).join('');

        if (seeMoreBtn) {
            seeMoreBtn.style.display = trips.length > 3 ? 'inline-flex' : 'none';
        }

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function toggleQuickCheck() {
        const extras = document.querySelectorAll('.ticket-card-extra');
        const btn = document.getElementById('see-more-btn');
        const isExpanded = btn.classList.contains('expanded');

        extras.forEach(function(card) {
            if (isExpanded) {
                card.classList.add('hidden');
            } else {
                card.classList.remove('hidden');
            }
        });

        if (isExpanded) {
            btn.classList.remove('expanded');
            btn.querySelector('span').textContent = 'View More Trips';
        } else {
            btn.classList.add('expanded');
            btn.querySelector('span').textContent = 'View Less';
        }

        if (window.lucide) window.lucide.createIcons();
    }

    // Swiper Carousel Initialization
    function initFleetSwiper() {
        new Swiper('.fleet-swiper', {
            slidesPerView: 1,
            spaceBetween: 24,
            loop: true,
            autoplay: {
                delay: 4500,
                disableOnInteraction: false,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            breakpoints: {
                768: {
                    slidesPerView: 2,
                },
                1024: {
                    slidesPerView: 3,
                }
            }
        });
    }

    // FAQ Accordion
    function toggleFaq(trigger) {
        const item = trigger.closest('.faq-item');
        const body = item.querySelector('.faq-body');
        const isOpen = item.classList.contains('open');

        // Close all
        document.querySelectorAll('.faq-item.open').forEach(el => {
            el.classList.remove('open');
            el.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
            el.querySelector('.faq-body').style.maxHeight = '0';
        });

        if (!isOpen) {
            item.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');
            body.style.maxHeight = body.scrollHeight + 'px';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        initHeroFlatpickr();
        loadLocations();
        loadQuickCheck();
        initFleetSwiper();
    });
</script>
}