@model IEnumerable<BenLanSystem.Models.DTOs.BlogPostDto>
@{
    ViewData["Title"] = "Blog";
    ViewData["Description"] = "Read the BenLan blog to discover Cambodia travel tips, hidden gems, and journey stories.";
    ViewData["ActivePage"] = "Blog";
}

@section Styles {
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true"/>
}

<section class="blog-listing-section" id="blog-page">
    <div class="blog-container">
        <div class="blog-listing-header">
            <p class="blog-listing-subtitle">Read the blog to understand more</p>
        </div>

        <div class="blog-cards-list" id="blog-cards-list">
            @if (!Model.Any())
            {
                <div style="padding:40px; color:#6b7280; text-align:center; background:#fff; border-radius:8px;">No published posts yet.</div>
            }
            else
            {
                foreach (var post in Model)
                {
                    var excerpt = post.Summary ?? (post.Content.Length > 200 ? post.Content.Substring(0, 200) + "..." : post.Content);
                    <article class="blog-card" id="blog-card-@post.Id">
                        <div class="blog-card-body">
                            <h2 class="blog-card-title">@post.Title</h2>
                            <p class="blog-card-excerpt">@excerpt</p>
                            <a asp-controller="Home" asp-action="BlogDetail" asp-route-id="@post.Id" class="blog-card-btn" id="blog-card-btn-@post.Id">
                                Read more
                            </a>
                        </div>
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <div class="blog-card-img-wrap">
                                <img src="@post.ImageUrl" alt="@post.Title" class="blog-card-img" loading="lazy" />
                            </div>
                        }
                    </article>
                }
            }
        </div>
    </div>
</section>
