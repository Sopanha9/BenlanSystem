<!-- Modern Luxe Footer -->
<footer class="luxe-footer" id="site-footer">
    <div class="footer-container">
        <div class="footer-grid">
            <!-- Col 1: Brand & Tagline -->
            <div class="footer-brand-col">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="footer-logo">
                    <span class="logo-mark"><i data-lucide="bus-front"></i></span>
                    <span class="logo-text">BEN<span class="logo-accent">LAN</span></span>
                </a>
                <p class="footer-about">
                    Cambodia's premier modern intercity transport network. Experience premium comfort, verified drivers, real-time tracking, and effortless digital booking across the Kingdom.
                </p>
                <div class="footer-trust-badges">
                    <span class="trust-badge"><i data-lucide="shield-check"></i> 100% Insured Trips</span>
                    <span class="trust-badge"><i data-lucide="award"></i> Certified VIP Fleet</span>
                </div>
            </div>

            <!-- Col 2: Quick Links -->
            <div class="footer-col">
                <h4 class="footer-heading">Explore</h4>
                <ul class="footer-nav">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Home" asp-action="BookTicket">Search Trips</a></li>
                    <li><a asp-controller="Home" asp-action="MyBookings">My Boarding Passes</a></li>
                    <li><a asp-controller="Home" asp-action="Blog">Travel Stories &amp; Guides</a></li>
                    <li><a asp-controller="Home" asp-action="About">About BenLan</a></li>
                </ul>
            </div>

            <!-- Col 3: Popular Destinations -->
            <div class="footer-col">
                <h4 class="footer-heading">Key Terminals</h4>
                <ul class="footer-nav">
                    <li><a asp-controller="Home" asp-action="BookTicket">Phnom Penh Terminal</a></li>
                    <li><a asp-controller="Home" asp-action="BookTicket">Siem Reap Central</a></li>
                    <li><a asp-controller="Home" asp-action="BookTicket">Sihanoukville Express</a></li>
                    <li><a asp-controller="Home" asp-action="BookTicket">Battambang Station</a></li>
                    <li><a asp-controller="Home" asp-action="BookTicket">Kampot &amp; Kep</a></li>
                </ul>
            </div>

            <!-- Col 4: Support & Newsletter -->
            <div class="footer-col">
                <h4 class="footer-heading">Support &amp; Terminals</h4>
                <div class="footer-contact-items">
                    <div class="contact-item">
                        <i data-lucide="phone-call" class="contact-icon"></i>
                        <div>
                            <span class="contact-label">24/7 Hotline</span>
                            <a href="tel:+85512345678" class="contact-val">+855 (0) 12 345 678</a>
                        </div>
                    </div>
                    <div class="contact-item">
                        <i data-lucide="mail" class="contact-icon"></i>
                        <div>
                            <span class="contact-label">General Inquiries</span>
                            <a href="mailto:support@benlan.com" class="contact-val">support@benlan.com</a>
                        </div>
                    </div>
                    <div class="contact-item">
                        <i data-lucide="clock" class="contact-icon"></i>
                        <div>
                            <span class="contact-label">Station Service</span>
                            <span class="contact-val">05:00 AM – 11:00 PM Daily</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p class="copyright-text">&copy; @DateTime.UtcNow.Year BenLan System. All rights reserved.</p>
            <div class="footer-payment-methods">
                <span class="payment-tag">ABA KHQR</span>
                <span class="payment-tag">ACLEDA</span>
                <span class="payment-tag">Wing</span>
                <span class="payment-tag">Visa / Mastercard</span>
            </div>
        </div>
    </div>
</footer>
